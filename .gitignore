### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# Python bytecode cache (demo workloads)
__pycache__/
*.pyc

# Generated capture / compile artifacts (from a live monitor or --compile run)
ebpf-mon/events.json
ebpf-mon/final-events.json
ebpf-mon/final-events-optimized.json

# Demo orchestrator state (generated by docs/demo/setup.sh)
docs/demo/.demo-env
docs/demo/recordings/
docs/demo/vulnapp-events.json
docs/demo/secretsvc-events.json
docs/demo/*-events.json
!docs/demo/example-events.json
